# Application
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://cloudops:cloudops@localhost:5432/cloudops_hub?schema=public"

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# AWS (optional - for AWS integration)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Prometheus (optional - for metrics)
PROMETHEUS_URL=http://localhost:9090

# Grafana (optional - for dashboards)
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=

# OpenSearch/Elasticsearch (optional - for logging)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# GitHub (optional - for CI/CD)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Docker (optional - for container management)
DOCKER_HOST=unix:///var/run/docker.sock

# Kubernetes (optional - for K8s integration)
KUBECONFIG_PATH=~/.kube/config

# Email (optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Slack (optional - for notifications)
SLACK_WEBHOOK_URL=

# Feature Flags
ENABLE_AWS_INTEGRATION=false
ENABLE_KUBERNETES_INTEGRATION=false
ENABLE_PROMETHEUS_INTEGRATION=false
ENABLE_GRAFANA_INTEGRATION=false
ENABLE_OPENSEARCH_INTEGRATION=false
ENABLE_DOCKER_INTEGRATION=false
ENABLE_GITHUB_INTEGRATION=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173